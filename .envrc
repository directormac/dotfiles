#!/usr/bin/env bash

# Exit early if DEVELOPMENT is not set to 1
if [ "$DEVELOPMENT" != "1" ]; then
	log_status "Skipping direnv: DEVELOPMENT=1 is not set"
	return
fi

# Watch files and directories relative to ~/.dotfiles root
watch_file nixos/flake.nix
watch_file nixos/flake.lock
watch_dir nixos/modules
watch_dir nixos/pkgs
watch_dir config

# Tell direnv to load the flake located inside the nixos directory
use flake ./nixos --impure
