{
  "title": "Zsh Keybinds",
  "provider": "zsh",
  "binds": {
    "Autosuggest & History": [
      {
        "key": "Ctrl+Y / Ctrl+Tab",
        "desc": "Accept autosuggestion",
        "subcat": "Autosuggest"
      },
      {
        "key": "Ctrl+Space",
        "desc": "Accept and immediately execute autosuggestion",
        "subcat": "Autosuggest"
      },
      {
        "key": "Ctrl+R",
        "desc": "Interactive SQLite history search (histdb-fzf)",
        "subcat": "History"
      },
      {
        "key": "Ctrl+Alt+R",
        "desc": "Interactive SQLite history search (histdb-skim)",
        "subcat": "History"
      },
      {
        "key": "Ctrl+Shift+R",
        "desc": "Television Slim history search",
        "subcat": "History"
      },
      {
        "key": "Up / Down",
        "desc": "Prefix history navigation",
        "subcat": "History"
      }
    ],
    "Navigation & Fuzzy Search": [
      {
        "key": "Tab",
        "desc": "Fuzzy completion menu (fzf-tab)",
        "subcat": "Completion"
      },
      {
        "key": "< / >",
        "desc": "Switch completion group in fzf-tab",
        "subcat": "Completion"
      },
      {
        "key": "Ctrl+O",
        "desc": "Super search (files, dirs, git) via fzf",
        "subcat": "Search"
      },
      {
        "key": "Ctrl+H",
        "desc": "Interactive fuzzy manpage & cheat.sh viewer",
        "subcat": "Docs"
      }
    ],
    "Vi Mode & Line Editing": [
      {
        "key": "Escape / Ctrl+[",
        "desc": "Switch to vi command mode (vicmd)",
        "subcat": "Mode"
      },
      {
        "key": "i / a",
        "desc": "Enter vi insert mode before / after cursor",
        "subcat": "Mode"
      },
      {
        "key": "v / vv (vicmd)",
        "desc": "Edit command line in $EDITOR (Neovim)",
        "subcat": "Editor"
      },
      {
        "key": "cs / ds / ys",
        "desc": "Vim surround: change, delete, add surrounding quotes/brackets",
        "subcat": "Surround"
      },
      {
        "key": "gp / gP",
        "desc": "Paste from system clipboard (wl-copy) after / before cursor",
        "subcat": "Clipboard"
      },
      {
        "key": "gx",
        "desc": "Open URL or path under cursor",
        "subcat": "Navigation"
      },
      {
        "key": "Ctrl+W",
        "desc": "Delete backward word",
        "subcat": "Editing"
      },
      {
        "key": "Ctrl+U",
        "desc": "Kill entire command line before cursor",
        "subcat": "Editing"
      },
      {
        "key": "Ctrl+K",
        "desc": "Kill entire command line after cursor",
        "subcat": "Editing"
      },
      {
        "key": "Ctrl+A / Ctrl+E",
        "desc": "Jump to beginning / end of line buffer",
        "subcat": "Navigation"
      },
      {
        "key": "Ctrl+_",
        "desc": "Undo last edit",
        "subcat": "Undo"
      },
      {
        "key": "Ctrl+L",
        "desc": "Clear terminal screen and redraw prompt",
        "subcat": "Screen"
      }
    ]
  }
}
