@@ -176,6 +176,28 @@ class LabelTest(unittest.TestCase):
         self.assertEqual(labels.compose("?", "logs", cfg, is_fallback=True), "? logs")
 
 
+    def test_auto_label_with_digit_and_glyphs(self):
+        self.assertTrue(labels.is_auto_label("1", 7))
+        self.assertTrue(labels.is_auto_label("一", 7))
+        self.assertTrue(labels.is_auto_label("①", 7))
+        self.assertTrue(labels.is_auto_label("✓ 2", 8))
+        self.assertFalse(labels.is_auto_label("editor", 7))
+
+    def test_compose_number_styles(self):
+        # Hide style: no number
+        self.assertEqual(labels.compose("V", "1", config(number_style="hide"), is_auto=True), "V")
+        # Kanji style: kanji numeral
+        self.assertEqual(labels.compose("V", "1", config(number_style="kanji"), is_auto=True), "V 一")
+        self.assertEqual(labels.compose("V", "2", config(number_style="kanji"), is_auto=True), "V 二")
+        # Circle style
+        self.assertEqual(labels.compose("V", "1", config(number_style="circle"), is_auto=True), "V ①")
+        # Fsquare style
+        self.assertEqual(labels.compose("V", "1", config(number_style="fsquare"), is_auto=True), "V 󰎤")
+        # Super style
+        self.assertEqual(labels.compose("V", "3", config(number_style="super"), is_auto=True), "V ³")
+        # User-named tab preserved
+        self.assertEqual(labels.compose("V", "editor", config(number_style="kanji"), is_auto=False), "V editor")
