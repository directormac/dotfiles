+}
+
+ALL_NUM_GLYPHS = {
+    glyph: idx
+    for fmt, mapping in NUMBER_MAPS.items()
+    for idx, glyph in enumerate(mapping)
+    if glyph.strip()
+}
+
+
+def extract_digit(label, number):
+    """Extract integer digit if label represents an auto number or formatted numeral."""
+    s = (label or "").strip()
+    if s == str(number) and str(number).isdigit():
+        return int(number)
+    if s.isdigit():
+        return int(s)
+    if s in ALL_NUM_GLYPHS:
+        return ALL_NUM_GLYPHS[s]
+    parts = s.split()
+    if parts and parts[-1].isdigit():
+        return int(parts[-1])
+    if parts and parts[-1] in ALL_NUM_GLYPHS:
+        return ALL_NUM_GLYPHS[parts[-1]]
+    if str(number).isdigit():
+        return int(number)
+    return None
+
+
+def format_digit(digit, style):
+    """Format an integer digit with the selected numeral style."""
+    if not style or style in ("hide", "none"):
+        return ""
+    if style == "ascii":
+        return str(digit)
+    if style == "random":
+        styles = list(NUMBER_MAPS.keys())
+        style = random.choice(styles)
+    mapping = NUMBER_MAPS.get(style)
+    if mapping and 0 <= digit < len(mapping):
+        return mapping[digit]
+    return str(digit)
+
 
