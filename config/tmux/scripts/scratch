#!/usr/bin/env bash
#
# tmux scratch buffers: named, persistent terminals that can be minimized
# (parked back into the `scratch` session) and spawned as a floating pane into
# any window of any session.
#
# Model
#   - one tmux session named `scratch` is the stash
#   - one window per buffer, window name == buffer name
#   - the window is named `scratch:<name>`, so buffers are directly addressable
#   - `_park` is a reserved window that keeps the session alive when every
#     buffer is spawned elsewhere; names starting with `_` are not buffers
#   - the set of buffers *is* the set of @scratch_pane_<name> options; there is
#     no separate name list to keep in step with it (see sync)
#   - global options hold the state the status line reads:
#       @scratch_pane_<n>   pane id of buffer <n>   (the registry itself)
#       @scratch_count      number of live buffers  (display only, derived)
#       @scratch_list       names for the indicator (display only, derived)
#       @scratch_geom_<n>   "w h x y" float geometry, captured on minimize
#
# Mechanics (verified against tmux 3.8-rc3)
#   - `join-pane -s <src> -t <dst-window>` moves a pane across windows AND
#     sessions, and lands it tiled.
#   - `break-pane -W -s <pane> -x W -y H -X X -Y Y` then lifts it out of the
#     tiled layout and floats it. `-t` cannot be used to select the pane
#     ("can't specify pane here"), so `-s` is required.
#   - tmux nudges requested geometry when pane borders / pane-border-status
#     are active, so the *effective* geometry is captured after spawning and
#     re-applied verbatim on the next spawn.
#   - the pane's process survives the join/break round trip untouched.

set -uo pipefail

SESSION="scratch"
PARK="_park"

# Absolute path to this script, used to re-invoke it from tmux menus. Those go
# through /bin/sh in the tmux *server's* working directory, so a relative $0
# would not resolve there.
case "$0" in
*/*) SELF="$(cd -- "$(dirname -- "$0")" 2>/dev/null && pwd)/$(basename -- "$0")" ;;
*) SELF="$(command -v -- "$0" 2>/dev/null || printf '%s' "$0")" ;;
esac

# ---------------------------------------------------------------- tmux helpers

t() { tmux "$@"; }

# Build a tmux command that re-invokes this script, keeping the whole
# invocation inside a single quoted shell-command word.
#
# `run-shell` parses its own command line, and its trailing `[argument ...]`
# values are only ever surfaced as #{1}, #{2} - they are never appended to
# shell-command. Written as separate tokens the arguments are dropped and the
# script runs bare, which falls into the usage branch and looks like the binding
# is simply dead. display-menu item commands are parsed the same way, so they
# need the same treatment.
self_cmd() {
	local cmd="$SELF $*"
	cmd="${cmd//\'/\'\\\'\'}"
	printf "run-shell -b '%s'" "$cmd"
}

# tmux only has `has-session`, so window and pane existence is tested by asking
# the target to list itself.
win_exists() { [ -n "$(t list-windows -t "$1" -F '#{window_id}' 2>/dev/null)" ]; }
pane_exists() { [ -n "$(t list-panes -t "$1" -F '#{pane_id}' 2>/dev/null)" ]; }

# `display-message` succeeds even when nothing is attached, which silently
# swallows messages when the script is run from a terminal or under run-shell.
# Only use it when there is actually a client to show it.
_notify() {
	if [ -n "$(t list-clients -F '#{client_name}' 2>/dev/null)" ]; then
		t display-message "$1" 2>/dev/null
	else
		printf '%s\n' "$1" >&2
	fi
}
msg() { _notify "$*"; }
err() { _notify "scratch: $*"; }

# Validate a buffer name. Names are identifiers only: they end up in tmux option
# *names* (@scratch_pane_<name>), in a space separated registry, and in the value
# of that registry - which set-option writes with -F, expanding any format it
# finds. Allowing `#`, `{` or `}` through would let a name rewrite the options
# it is stored in. Leading _ is reserved for internal windows.
valid_name() {
	case "$1" in
		*[!A-Za-z0-9_-]* | -* | "") return 1 ;;
		_*) return 1 ;;
		*) return 0 ;;
	esac
}

opt() { t show-options -gv "$1" 2>/dev/null; }
setopt() { t set-option -gF "$1" "$2"; }
unsetopt() { t set-option -gu "$1" 2>/dev/null; }

# Buffer names are plain identifiers (validated above) so word splitting is safe
# and the space separated registry needs no quoting anywhere.
# Live buffer names, derived from the @scratch_pane_<name> options themselves.
#
# The options *are* the registry. An earlier design also kept a space separated
# @scratch_names list, but registering a buffer then became a read-modify-write
# of that option with no lock. tmux runs the reap hook from a background shell,
# and users fire `new` in quick succession, so concurrent invocations dropped
# each other's writes: buffers got created but never registered, and the name
# list silently disagreed with the options. Deriving the names means the only
# mutation is a single option write, which is idempotent and therefore safe to
# run concurrently. show-options -g returns options in a stable sorted order, so
# the status line gets a deterministic list for free.
names() {
	local o
	for o in $(t show-options -g 2>/dev/null |
		sed -n 's/^@scratch_pane_\([^ ]*\) .*/\1/p'); do
		printf '%s\n' "$o"
	done
	return 0
}

# The names shown in the status right indicator.
list_names() {
	local n out=""
	for n in $(names); do
		out="${out:+$out }$n"
	done
	printf '%s' "$out"
}

sync() {
	local count n pane
	# Self heal: a buffer whose pane was destroyed with kill-pane leaves no
	# trace for any hook to report (see reap), so drop those entries here.
	# This runs on every entry point, which makes the registry converge on the
	# real state instead of drifting.
	for n in $(names); do
		pane="$(opt "@scratch_pane_$n")"
		[ -n "$pane" ] && pane_exists "$pane" && continue
		unsetopt "@scratch_pane_$n"
		unsetopt "@scratch_geom_$n"
	done
	count="$(names | grep -c . || true)"
	setopt @scratch_count "$count"
	setopt @scratch_list "$(list_names)"
}

register() { # <name> <pane>
	setopt "@scratch_pane_$1" "$2"
	sync
}

unregister() { # <name>
	unsetopt "@scratch_pane_$1"
	unsetopt "@scratch_geom_$1"
	sync
}

# ---------------------------------------------------------------- stash layout

stash_exists() { t has-session -t "$SESSION" 2>/dev/null; }

ensure_stash() {
	stash_exists && return 0
	t new-session -d -s "$SESSION" -n "$PARK" -x 80 -y 24 || return 1
	t set-option -t "$SESSION" -w automatic-rename off 2>/dev/null
	t set-option -t "$SESSION" -w allow-rename off 2>/dev/null
	# Keep the park window out of the way when the session is visited.
	t set-option -t "$SESSION:$PARK" -w window-size manual 2>/dev/null
	t resize-window -t "$SESSION:$PARK" -x 20 -y 5 2>/dev/null
	return 0
}

stash_pane() { t list-panes -t "$SESSION:$1" -F '#{pane_id}' 2>/dev/null | head -n1; }

# A stash window holds exactly one pane: the buffer. `new-window` used to open
# the parked window creates its own pane, which becomes a stray once the buffer
# is joined in, so drop anything that is not the buffer itself.
prune_stash() { # <name> <keep-pane>
	local p
	for p in $(t list-panes -t "$SESSION:$1" -F '#{pane_id}' 2>/dev/null); do
		[ "$p" = "$2" ] || t kill-pane -t "$p" 2>/dev/null
	done
	return 0
}

# Move <src-pane> into <dst-window>. `join-pane -t <window>` targets that
# window's *active* pane, and tmux refuses to split a floating one ("size or
# position can't split a floating pane"), so try each pane in turn. A window
# always has at least one tiled pane, so this terminates.
join_into_window() { # <src-pane> <dst-window>
	local p
	for p in $(t list-panes -t "$2" -F '#{pane_id}' 2>/dev/null); do
		t join-pane -s "$1" -t "$p" 2>/dev/null && return 0
	done
	return 1
}

# Create the stash window for <name> if it is not already parked there.
ensure_parked() { # <name>
	ensure_stash
	win_exists "$SESSION:$1" && return 0
	t new-window -d -t "$SESSION" -n "$1" || return 1
	t set-option -t "$SESSION:$1" -w automatic-rename off 2>/dev/null
	return 0
}

# ------------------------------------------------------------------- geometry

# tmux is inconsistent about floating pane geometry, so the values handed to
# break-pane -x/-y/-X/-Y are not the values reported back afterwards:
#
#   -X/-Y are one based while pane_left/pane_top are zero based, so the same
#   number round trips one cell off in each direction.
#   -x/-y are the size of the box the pane is put in, which is two columns and
#   two rows larger than the pane itself, so a naive round trip shrinks the
#   pane by 2x2 every single time it is spawned again.
#
# Both offsets are undone here so that a spawn/minimize cycle is lossless.
geom_get() {
	t display-message -p -t "$1" \
		'#{pane_width} #{pane_height} #{pane_left} #{pane_top}' 2>/dev/null
}

geom_store() { # <name> <pane>
	local w h x y
	read -r w h x y <<<"$(geom_get "$2")"
	[ -n "$w" ] || return 0
	setopt "@scratch_geom_$1" "$((w + 2)) $((h + 2)) $((x - 1)) $((y - 1))"
}

# Geometry to spawn with. On the first spawn there is nothing stored, so return
# nothing and let tmux pick its own default, which *cascades* each new float from
# the top-left. Passing our own centred default instead would stack every buffer
# at the same coordinates and hide all but the newest.
geom_resolve() { # <name>
	opt "@scratch_geom_$1"
}

# -------------------------------------------------------------------- actions

spawn() { # <name> [dst-window]
	local name="$1" dst="${2:-}" pane g
	sync
	[ -n "$name" ] || { err "no buffer name"; return 1; }
	valid_name "$name" || { err "invalid buffer name: $name"; return 1; }

	if [ -z "$dst" ]; then
		dst="$(t display-message -p '#{window_id}' 2>/dev/null)"
	fi
	[ -n "$dst" ] || {
		err "no destination window (pass one explicitly)"
		return 1
	}
	win_exists "$dst" || {
		err "no such window: $dst"
		return 1
	}

	pane="$(opt "@scratch_pane_$name")"
	if [ -z "$pane" ] || ! pane_exists "$pane"; then
		# not parked (or gone): it must already live in the stash
		pane="$(stash_pane "$name")"
		[ -n "$pane" ] || { err "no such buffer: $name"; return 1; }
	fi

	# move it into the destination window, tiled ...
	if ! join_into_window "$pane" "$dst"; then
		err "could not move $name into $dst"
		return 1
	fi
	# ... then lift it out of the tiled layout and float it. With no stored
	# geometry tmux applies its own default and cascades the pane so it does
	# not land on top of an existing buffer.
	# shellcheck disable=SC2206 # deliberate word splitting of the geometry
	local -a g
	g=( $(geom_resolve "$name") )
	if [ "${#g[@]}" -eq 4 ]; then
		if ! t break-pane -W -s "$pane" \
			-x "${g[0]}" -y "${g[1]}" -X "${g[2]}" -Y "${g[3]}" 2>/dev/null; then
			err "could not float $name"
			return 1
		fi
	elif ! t break-pane -W -s "$pane" 2>/dev/null; then
		err "could not float $name"
		return 1
	fi
	t select-pane -t "$pane" 2>/dev/null
	t select-pane -t "$pane" -T "scratch:$name" 2>/dev/null
	geom_store "$name" "$pane" # tmux nudges geometry; keep the effective value
	setopt "@scratch_pane_$name" "$pane"
	msg "scratch: $name spawned into $dst"
}

new() { # <name> [dst-window] [command...]
	local name="$1" dst="$2" pane dir
	shift 2 2>/dev/null || shift $# # drop <name> and the optional dst
	[ -n "$name" ] || { err "no buffer name"; return 1; }
	valid_name "$name" || {
		err "invalid name: letters, digits, - and _ only, no leading _"
		return 1
	}
	# Validate the destination before creating anything, so a bad window does
	# not leave a half made buffer behind in the stash.
	[ -n "$dst" ] || dst="$(t display-message -p '#{window_id}' 2>/dev/null)"
	[ -n "$dst" ] && win_exists "$dst" || {
		err "no destination window: ${dst:-<none>}"
		return 1
	}
	ensure_stash || { err "could not create the $SESSION session"; return 1; }

	if win_exists "$SESSION:$name" ||
		[ -n "$(opt "@scratch_pane_$name")" ]; then
		err "buffer already exists: $name"
		return 1
	fi

	# A window made in the stash session starts in whatever directory the
	# script itself was run from, which is nowhere useful. The buffer is about
	# to be spawned into the destination window, so start it where that
	# window's active pane is instead.
	dir="$(t display-message -p -t "$dst" '#{pane_current_path}' 2>/dev/null)"

	pane="$(t new-window -d -t "$SESSION" -n "$name" ${dir:+-c "$dir"} \
		-P -F '#{pane_id}' "$@")" || {
		err "could not create buffer: $name"
		return 1
	}
	t set-option -t "$SESSION:$name" -w automatic-rename off 2>/dev/null
	t select-pane -t "$pane" -T "scratch:$name" 2>/dev/null
	register "$name" "$pane"
	spawn "$name" "$dst"
}

# Which buffer does <pane> belong to, if any?
#
# The registry is authoritative: @scratch_pane_<name> records the pane id that
# belongs to each buffer, so a lookup settles it without trusting the pane's
# title. The title is only a fallback for the window of the stash session, where
# the pane has just been joined in and its id is already known.
owner_of() { # <pane>
	local name
	for name in $(names); do
		[ "$(opt "@scratch_pane_$name")" = "$1" ] && {
			printf '%s' "$name"
			return 0
		}
	done
	return 1
}

pane_of() { # <name>
	local p
	p="$(opt "@scratch_pane_$1")"
	[ -n "$p" ] || return 1
	printf '%s' "$p"
}

minimize() { # [pane|buffer]
	local pane="${1:-}" title name
	sync
	[ -n "$pane" ] || pane="$(t display-message -p '#{pane_id}')"

	# Accept a buffer name as well as a pane id, so minimize takes the same
	# argument as spawn and kill. A pane id from list-panes always starts with
	# %, so anything else is a name; if it is not a buffer the title lookup below
	# reports it rather than silently parking the wrong pane.
	case "$pane" in
	%*) ;;
	*)
		if name="$(pane_of "$pane")"; then
			pane="$name"
		fi
		;;
	esac

	# Prefer the registry over the title: `select-pane -T` writes scratch:<name>
	# once, and any application that sets its own pane title overwrites it, after
	# which a title lookup reports a perfectly good buffer as "not a scratch
	# buffer".
	if ! name="$(owner_of "$pane")"; then
		title="$(t display-message -p -t "$pane" '#{pane_title}')"
		case "$title" in
			scratch:*) name="${title#scratch:}" ;;
			*)
				err "not a scratch buffer: $pane"
				return 1
				;;
		esac
	fi

	if [ "$(t display-message -p -t "$pane" '#{session_name}')" = "$SESSION" ]; then
		err "$name is already minimized"
		return 1
	fi

	geom_store "$name" "$pane"
	ensure_parked "$name" || { err "could not open $SESSION:$name"; return 1; }
	if ! join_into_window "$pane" "$SESSION:$name"; then
		err "could not minimize $name"
		return 1
	fi
	prune_stash "$name" "$pane"
	t select-pane -t "$pane" -T "scratch:$name" 2>/dev/null
	setopt "@scratch_pane_$name" "$pane"
	sync
	msg "scratch: $name minimized"
}

kill_one() { # <name>
	local name="$1" pane
	sync
	[ -n "$name" ] || { err "no buffer name"; return 1; }
	pane="$(opt "@scratch_pane_$name")"
	if [ -n "$pane" ] && pane_exists "$pane"; then
		t kill-pane -t "$pane" 2>/dev/null
	fi
	t kill-window -t "$SESSION:$name" 2>/dev/null
	unregister "$name"
	# drop the stash session once nothing is parked in it any more
	if [ -z "$(t list-windows -t "$SESSION" -F '#{window_name}' 2>/dev/null | grep -v "^$PARK\$")" ]; then
		t kill-session -t "$SESSION" 2>/dev/null
	fi
	msg "scratch: $name killed"
}

kill_menu() { # [dst-window]
	local args=() name
	sync
	while read -r name; do
		[ -n "$name" ] || continue
		args+=("$name" "" "$(self_cmd kill "$name")")
	done < <(names)
	if [ "${#args[@]}" -eq 0 ]; then
		err "no scratch buffers"
		return 1
	fi
	t display-menu -T " kill scratch buffer " "${args[@]}"
}

# Remove a buffer whose pane exited, so the indicator cannot go stale.
# Hook helper. tmux expands #{hook_pane} while it is still parsing the config
# file, where there is no pane to name, so by the time this runs it is handed no
# argument at all. Pruning the whole registry works regardless and costs a
# handful of option lookups, so the pane argument is only ever an optimisation.
reap() { # [pane]
	local pane="${1:-}" name owner
	if [ -n "$pane" ]; then
		for name in $(names); do
			owner="$(opt "@scratch_pane_$name")"
			[ "$owner" = "$pane" ] || continue
			pane_exists "$pane" && return 0 # still alive
			unregister "$name"
			return 0
		done
		return 0
	fi
	sync
}

pick() { # [dst-window]
	local dst="${1:-}" args=() name
	sync
	[ -n "$dst" ] || dst="$(t display-message -p '#{window_id}')"
	while read -r name; do
		[ -n "$name" ] || continue
		args+=("$name" "" "$(self_cmd spawn "$name" "$dst")")
	done < <(names)
	if [ "${#args[@]}" -eq 0 ]; then
		err "no scratch buffers yet - create one with prefix + b n"
		return 1
	fi
	t display-menu -T " scratch buffers " "${args[@]}"
}

list() {
	local name state n=0 out=""
	sync
	while read -r name; do
		[ -n "$name" ] || continue
		if [ "$(t display-message -p -t "$(opt "@scratch_pane_$name")" '#{session_name}' 2>/dev/null)" = "$SESSION" ]; then
			state="minimized"
		else
			state="spawned"
		fi
		out="${out:+$out$'\n'}$name ($state)"
		n=$((n + 1))
	done < <(names)
	if [ "$n" -eq 0 ]; then
		msg "scratch: no buffers"
		return 0
	fi
	# One message, not one per buffer: display-message replaces whatever was
	# there before, so a message per buffer only ever leaves the last one
	# visible.
	_notify "$(printf 'scratch buffers (%d):%s' "$n" "$out")"
}

# ----------------------------------------------------------------- dispatcher

usage() {
	local text
	text="$(cat <<'EOF'
usage: scratch <command> [args]

  new <name> [window] [command...]  create a buffer and spawn it
  spawn <name> [window]    spawn a buffer as a floating pane
  pick [window]            choose a buffer to spawn from a menu
  minimize [pane]          send the active scratch pane back to the stash
  kill <name>              kill a buffer
  kill-menu                choose a buffer to kill from a menu
  list                     list buffers
  reap [pane]            forget buffers whose pane is gone (hook helper)
  sync                    rebuild the status line registry
EOF
)"

	if [ "${1:-}" = "--bare" ]; then
		# A bare invocation is almost never someone asking for help, it means
		# the caller lost the arguments. Help text on stdout is useless here:
		# `run-shell -b` throws the child's stdout away, which is exactly how a
		# dropped argument goes unnoticed. Say so in the status line instead.
		err "no command given - arguments were dropped by the caller?"
		err "see $SELF for the command list"
		printf '%s\n' "$text" >&2
		exit 1
	fi
	printf '%s\n' "$text"
}

cmd="${1:-}"
[ "$#" -gt 0 ] && shift

case "$cmd" in
new) new "$@" ;;
spawn) spawn "$@" ;;
pick) pick "$@" ;;
minimize) minimize "$@" ;;
kill) kill_one "$@" ;;
kill-menu) kill_menu "$@" ;;
list | ls) list ;;
reap) reap "$@" ;;
sync) sync ;;
-h | --help | help) usage ;;
"") usage --bare ;;
*)
	err "unknown command: $cmd"
	usage >&2
	exit 1
	;;
esac
