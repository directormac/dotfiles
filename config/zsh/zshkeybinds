# ==============================================================================
# ZSH KEYBINDINGS CONFIGURATION & REFERENCE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Standard Navigation & Basic Editing (Emacs Style Basics)
# ------------------------------------------------------------------------------
bindkey "^A" beginning-of-line       # Ctrl + A : Jump to the beginning of the line
bindkey "^E" end-of-line             # Ctrl + E : Jump to the end of the line
bindkey "^B" backward-char           # Ctrl + B : Move cursor back one character
bindkey "^F" forward-char            # Ctrl + F : Move cursor forward one character
bindkey "^H" vi-backward-delete-char # Ctrl + H (Backspace) : Delete char behind cursor
bindkey "^?" backward-delete-char    # Backspace key : Delete character behind cursor
bindkey "^Y" yank                    # Ctrl + Y : Paste previously cut/killed text
bindkey "^_" undo                    # Ctrl + Undo : Revert the last editing change

# ------------------------------------------------------------------------------
# 2. Terminal Control & Execution Flags
# ------------------------------------------------------------------------------
bindkey "^J" accept-line      # Ctrl + J (Line Feed) : Execute current command
bindkey "^M" accept-line      # Ctrl + M (Return) : Execute current command
bindkey "^L" clear-screen     # Ctrl + L : Clear terminal screen display
bindkey "^Q" vi-quoted-insert # Ctrl + Q : Insert next character verbatim
bindkey "^V" vi-quoted-insert # Ctrl + V : Insert next character verbatim

# ------------------------------------------------------------------------------
# 3. Terminal Arrow Keys & System Mapping
# ------------------------------------------------------------------------------
bindkey "^[OA" up-line-or-history            # Up Arrow (alternate code) : Previous history item
bindkey "^[OB" down-line-or-history          # Down Arrow (alternate code) : Next history item
bindkey "^[OC" vi-forward-char               # Right Arrow (alternate code) : Move forward
bindkey "^[OD" vi-backward-char              # Left Arrow (alternate code) : Move backward
bindkey "^[[A" history-substring-search-up   # Up Arrow : Match history matching typed text
bindkey "^[[B" history-substring-search-down # Down Arrow : Match history matching typed text
bindkey "^[[C" vi-forward-char               # Right Arrow : Move one character right
bindkey "^[[D" vi-backward-char              # Left Arrow : Move one character left
bindkey "^[[F" end-of-line                   # End Key : Jump to end of line
bindkey "^[[H" beginning-of-line             # Home Key : Jump to beginning of line
bindkey "^[[3~" delete-char                  # Delete Key : Delete character in front of cursor
bindkey "^[[200~" bracketed-paste            # Handles safe multi-line pasting without executing

# ------------------------------------------------------------------------------
# 4. Zsh Vi Mode (ZVM Plugin Modifications)
# ------------------------------------------------------------------------------
bindkey "^[" zvm_readkeys_handler  # Escape Key : Enters Vi command mode interceptor
bindkey "^K" zvm_forward_kill_line # Ctrl + K : Kill line forward using Vi Mode rules
bindkey "^U" zvm_viins_undo        # Ctrl + U : Undo changes while in Vi Insert mode

# ------------------------------------------------------------------------------
# 5. Native Zsh Advanced Completion & History Expansion (Ctrl + X Group)
# ------------------------------------------------------------------------------
bindkey "^X^R" _read_comp             # Ctrl+X, Ctrl+R : Read and update completions
bindkey "^X?" _complete_debug         # Ctrl+X, ? : Perform completion with debug logging
bindkey "^XC" _correct_filename       # Ctrl+X, C : Attempt filename spelling correction
bindkey "^Xa" _expand_alias           # Ctrl+X, A : Expand alias under cursor inline
bindkey "^Xc" _correct_word           # Ctrl+X, C : Attempt word spelling correction
bindkey "^Xd" _list_expansions        # Ctrl+X, D : List potential expansions
bindkey "^Xe" _expand_word            # Ctrl+X, E : Expand word under cursor inline
bindkey "^Xh" _complete_help          # Ctrl+X, H : Contextual help for current completion
bindkey "^Xm" _most_recent_file       # Ctrl+X, M : Insert path of most recently modified file
bindkey "^Xn" _next_tags              # Ctrl+X, N : Toggle through sorting completion tags
bindkey "^Xt" _complete_tag           # Ctrl+X, T : Complete dynamic tags
bindkey "^X~" _bash_list-choices      # Ctrl+X, ~ : Emulate Bash style list choices
bindkey "^[," _history-complete-newer # Alt + , : Search forward for history completions
bindkey "[/" _history-complete-older  # Alt + / : Search backward for history completions
bindkey "^[~" _bash_complete-word     # Alt + ~ : Emulate Bash style word completions

# ------------------------------------------------------------------------------
# 6. FZF & Terminal Plugin Integrations (fzf, fzf-tab, navi, sesh)
# ------------------------------------------------------------------------------
bindkey "^I" fzf-tab-complete                    # Tab key : Trigger fzf-powered tab completion menu
bindkey "^X." fzf-tab-debug                      # Ctrl+X, . : Debug menu wrapper for fzf-tab tool
bindkey "^R" history-incremental-search-backward # Ctrl+R : FZF interactive history picker
bindkey "^S" history-incremental-search-forward  # Ctrl+S : Forward history search fallback
bindkey "^T" fzf-file-widget                     # Ctrl + T : FZF fuzzy file path finder
bindkey "^[c" fzf-cd-widget                      # Alt + C : FZF fuzzy directory changer
bindkey "^[" _navi_widget                        # Ctrl + ] : Launch Navi interactive cheatsheet launcher
bindkey "^[s" sesh-sessions                      # Alt + S : Launch Sesh smart terminal session manager
bindkey "^[Q" zi-browse-symbol                   # Alt + Q : ZI plugin manager symbol browser

# ------------------------------------------------------------------------------
# 7. FZF Git Extension Widgets (Ctrl + G Chord Combo)
# ------------------------------------------------------------------------------
# Sub-mappings using upper-case combinations
bindkey "^G^B" fzf-git-branches-widget       # Ctrl+G, Ctrl+B : Interactive Git branches picker
bindkey "^G^E" fzf-git-each_ref-widget       # Ctrl+G, Ctrl+E : Interactive Git reference picker
bindkey "^G^F" fzf-git-files-widget          # Ctrl+G, Ctrl+F : Interactive Git file status picker
bindkey "^G^H" fzf-git-hashes-widget         # Ctrl+G, Ctrl+H : Interactive Git commit logs picker
bindkey "^G^L" fzf-git-lreflogs-widget       # Ctrl+G, Ctrl+L : Interactive Git reflog viewer
bindkey "^G^R" fzf-git-remotes-widget        # Ctrl+G, Ctrl+R : Interactive Git remotes picker
bindkey "^G^S" fzf-git-stashes-widget        # Ctrl+G, Ctrl+S : Interactive Git stashes picker
bindkey "^G^T" fzf-git-tags-widget           # Ctrl+G, Ctrl+T : Interactive Git tags picker
bindkey "^G^W" fzf-git-worktrees-widget      # Ctrl+G, Ctrl+W : Interactive Git worktrees picker
bindkey "^G?" fzf-git-?list_bindings-widget  # Ctrl+G, ? : List all available fzf-git maps
bindkey "^G^?" fzf-git-?list_bindings-widget # Ctrl+G, Backspace : Show keybinding assistance

# Sub-mappings duplicate configurations using lower-case combinations
bindkey "^Gb" fzf-git-branches-widget  # Ctrl+G, B : Interactive Git branches picker
bindkey "^Ge" fzf-git-each_ref-widget  # Ctrl+G, E : Interactive Git reference picker
bindkey "^Gf" fzf-git-files-widget     # Ctrl+G, F : Interactive Git file status picker
bindkey "^Gh" fzf-git-hashes-widget    # Ctrl+G, H : Interactive Git commit logs picker
bindkey "^Gl" fzf-git-lreflogs-widget  # Ctrl+G, L : Interactive Git reflog viewer
bindkey "^Gr" fzf-git-remotes-widget   # Ctrl+G, R : Interactive Git remotes picker
bindkey "^Gs" fzf-git-stashes-widget   # Ctrl+G, S : Interactive Git stashes picker
bindkey "^Gt" fzf-git-tags-widget      # Ctrl+G, T : Interactive Git tags picker
bindkey "^Gw" fzf-git-worktrees-widget # Ctrl+G, W : Interactive Git worktrees picker

# ------------------------------------------------------------------------------
# 8. Core Literal Character Mappings (Fallback self-inserts)
# ------------------------------------------------------------------------------
bindkey "^C" self-insert            # Ctrl + C : Fallback literal text insertion override
bindkey "^D" list-choices           # Ctrl + D : List options when no text is active
bindkey "^O" self-insert            # Ctrl + O : Literal text insertion override
bindkey "^Z" self-insert            # Ctrl + Z : Literal text insertion override
bindkey "^\\\\" self-insert         # Ctrl + \ : Literal text insertion override
bindkey "^\^" self-insert           # Ctrl + ^ : Literal text insertion override
bindkey " "-"~" self-insert         # Standard typed printable printable text space
bindkey "\M-^@"-"\M-^?" self-insert # Special meta/multibyte system character handlers
