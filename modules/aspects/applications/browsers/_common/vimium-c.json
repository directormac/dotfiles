  "keyMappings": [
    "#!no-check",
    "# --- Tab Navigation for Sidebery (Vertical Tabs) ---",
    "map J nextTab",
    "map K previousTab",
    "map <c-6> visitPreviousTab",
    "map ^ visitPreviousTab",
    "map g0 firstTab",
    "map g$ lastTab",
    "",
    "# --- Tab Management ---",
    "map t createTab position=\"end\"",
    "map x removeTab",
    "map X restoreTab",
    "map yt duplicateTab",
    "map << moveTabLeft",
    "map >> moveTabRight",
    "map W moveTabToNewWindow",
    "map gp togglePinTab",
    "map m toggleMuteTab",
    "",
    "# --- Vomnibar & Find ---",
    "map T Vomnibar.activateTabs",
    "map b Vomnibar.activateBookmarks",
    "map B Vomnibar.activateBookmarksInNewTab position=\"end\"",
    "map o Vomnibar.activate",
    "map O Vomnibar.activateInNewTab position=\"end\"",
    "",
    "# --- Page Navigation ---",
    "map <c-d> scrollPageDown",
    "map <c-u> scrollPageUp",
    "map d scrollPageDown",
    "map u scrollPageUp"
  ],
